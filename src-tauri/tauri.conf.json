{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Immersio",
  "version": "1.3.0",
  "identifier": "com.limusic.desktop",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "test -d ui && pnpm --dir ui dev || pnpm --dir ../ui dev",
    "beforeBuildCommand": "test -d ui && pnpm --dir ui build || pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Immersio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": ["deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libmpv2", "libc6 (>= 2.39)"]
      },
      "rpm": {
        "depends": ["libappindicator-gtk3", "mpv-libs"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/quiqxiq/immersio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCNzEzQ0RCMzNDMzI1NDgKUldSSUpjTXoyenh4UytpZGx1Nm9SUlZUNW4zL1lDTGN3SFdPbWplZTNjRHcvVnpLWU9CSWFOZzkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
